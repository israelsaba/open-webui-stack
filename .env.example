# ============================================================================
# Open WebUI Stack Environment Configuration
# ============================================================================
# Copy this file to .env and configure for your environment
# cp .env.example .env

# ============================================================================
# General Configuration
# ============================================================================
# Environment: DEV | PROD
ENV=DEV

# ============================================================================
# Docker Compose Configuration
# ============================================================================
# SDK Interface container port. The service is internal to the Compose network.
SDK_PORT=8060

# Set to true if using external Docker volume for open-webui
IS_EXTERNAL_OI_VOLUME=false

# ============================================================================
# SDK Interface Configuration (prefix: SDK__)
# All variables with SDK__ prefix are passed to the sdk-interface service
# ============================================================================

# API Keys for External Providers
SDK__ANTHROPIC_API_KEY=
SDK__GOOGLE_API_KEY=
SDK__GROK_API_KEY=

# Authentication
# Format: username1:token1;username2:token2
# Tokens must start with op_wui_
# Example: SDK__API_KEYS=admin:op_wui_abc123;user:op_wui_def456
# Required when SDK__ENVIRONMENT=PROD.
SDK__API_KEYS=

# Server Configuration
SDK__ENVIRONMENT=DEV
SDK__HOST=0.0.0.0
SDK__PORT=8060
SDK__LOG_LEVEL=info
SDK__DETAILED_REQUEST_LOGGING=false

# CORS Configuration
# Comma-separated list of allowed origins, or "*" for all
# Production example: SDK__CORS_ORIGINS=https://gpt.israelsaba.com.br
# Development: SDK__CORS_ORIGINS=*
SDK__CORS_ORIGINS=http://localhost:8090,http://localhost:3000

# ============================================================================
# Testing Configuration (for local testing only)
# ============================================================================

# Test mode: "mock" (uses mocked APIs) or "real" (uses actual APIs)
# Default: mock (no API keys needed)
SDK__TEST_MODE=mock

# Test model overrides (optional)
SDK__TEST_MODEL_ANTHROPIC=claude-sonnet-4-5-20250929
SDK__TEST_MODEL_GEMINI=gemini-2.0-flash-exp
SDK__TEST_MODEL_GEMINI_DEEP_RESEARCH=deep-research-pro-preview-12-2025
SDK__TEST_MODEL_GROK=grok-code-fast-1

# SDK base URL for testing
SDK__BASE_URL=http://localhost:8060

# ============================================================================
# Open WebUI Configuration (optional)
# ============================================================================
GOOGLE_PSE_API_KEY=
GOOGLE_PSE_ENGINE_ID=
