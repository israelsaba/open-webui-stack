# Test Environment Configuration
# Copy this to .env.test and configure for testing

# Test Mode: Set to "mock" to use mocked responses, "real" to use actual APIs
TEST_MODE=mock

# API Keys (only needed if TEST_MODE=real)
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=

# Test Configuration
SDK_BASE_URL=http://localhost:8060
LOG_LEVEL=info

# Test Model Overrides (optional)
TEST_MODEL_ANTHROPIC=claude-sonnet-4-5-20250929
TEST_MODEL_GEMINI=gemini-2.0-flash-exp
TEST_MODEL_GEMINI_DEEP_RESEARCH=deep-research-pro-preview-12-2025
TEST_MODEL_GROK=grok-code-fast-1
